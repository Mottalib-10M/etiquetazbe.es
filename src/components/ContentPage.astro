---
/**
 * Rendu d'une page de `src/content/pages/`. Ordre (RECETTE §5, §9.3, §21) : H1 et une phrase, puis tout de suite
 * le simulateur (visible sans défiler) ; page outil : simulateur puis bloc citable replié ; guide : mini-
 * simulateur, bloc citable, texte. Fiche ville ou commune générée depuis les données, puis FAQ, liens, sources.
 */
import PageLayout from '../layouts/PageLayout.astro';
import MiniSim from './calc/MiniSim';
import Clamp from './Clamp.astro';
import ToolSwitch from './ToolSwitch.astro';
import CityFacts from './CityFacts.astro';
import CiudadesAgrupadas from './CiudadesAgrupadas.astro';
import { hrefDe } from '../lib/href';
import MuniFacts from './MuniFacts.astro';
import { municipio } from '../lib/engine/ivtm';
import { pageDeMunicipio } from '../lib/pages';
import AdSlot from './AdSlot.astro';
import { route, ROUTES, type Locale } from '../i18n/routes';
import { label } from '../i18n/nav';
import { t } from '../i18n/ui';
import { pageById } from '../lib/pages';
import { helpers } from '../lib/helpers';
import { P } from '../lib/engine/params';
import { articleSchema, faqSchema, breadcrumbSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { AUTHOR_NAME } from '../data/site-config';
import type { PageDef } from '../lib/page-types';
interface Props { page: PageDef; lang: Locale }
const { page, lang } = Astro.props;
const x = page[lang];
const ui = t(lang);
const h = helpers(lang);
const path = route(page.id, lang);
const parts = x.body(h).split(/<!--mini:([A-Za-z0-9_]+)-->/);
const faqs = x.faqs(h);
const jsonLd = [webPageSchema({ name: x.h1, description: x.description, path, lang }), breadcrumbSchema([{ name: ui.breadcrumbHome, path: route('home', lang) }, { name: x.nav, path }])];
if (page.tool) jsonLd.push(webApplicationSchema({ name: x.h1, description: x.description, path, lang })); else jsonLd.push(articleSchema({ title: x.h1, description: x.description, path, lang }));
if (faqs.length) jsonLd.push(faqSchema(faqs, lang));
const related = page.related.filter((id) => hrefDe(id, lang)).map((id) => ({ href: hrefDe(id, lang)!, name: label(id, lang), description: pageById(id)?.[lang].card ?? '' }));
const sources = page.sources.map((k) => ({ name: P.sources[k].label[lang], url: P.sources[k].url }));
const methodHref = route('method', lang);
const cible = page.miniHref ?? 'home';
const miniHref = ROUTES.some((r) => r.id === cible) ? route(cible, lang) : undefined;
const preset = { ...(page.toolPreset ?? {}), ...(page.ciudad ? { ciudad: page.ciudad } : {}), ...(page.municipio ? { municipio: page.municipio } : {}) } as Record<string, never>;
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={faqs} related={related} sources={sources} breadcrumbs={[{ label: x.nav }]} dateEnHaut={!page.tool && !page.mini}>
  <article>
    <header class="mb-5">
      <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">{x.h1}</h1>
      <p class="mt-2 text-lg text-navy-700">{x.intro}</p>
    </header>
    {page.tool ? (
      <>
        <div data-outil><ToolSwitch tool={page.tool} lang={lang} methodHref={methodHref} preset={preset} /></div>
        {page.municipio ? <div data-chrome><Clamp text={x.resume(h)} lang={lang} id={`clamp-${page.id}`} class="mt-6" /></div> : <Clamp text={x.resume(h)} lang={lang} id={`clamp-${page.id}`} class="mt-6" />}
      </>
    ) : (
      <>
        {page.mini && <MiniSim client:load kind={page.mini} lang={lang} href={miniHref} defaults={page.miniDefaults} lead />}
        <p class="mt-6 text-navy-800">{x.resume(h)}</p>
      </>
    )}
    <p class="mt-3 text-sm text-navy-600">{ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> · <a href={route('editorial', lang)} class="underline hover:text-navy-900">{ui.editorialPolicy}</a> · <a href={methodHref} class="underline hover:text-navy-900">{label('method', lang)}</a></p>
    <div class="prose prose-slate mt-8 max-w-none">
      {parts.map((p, i) => i % 2 === 0 ? <Fragment set:html={p} /> : <MiniSim client:load kind={p} lang={lang} href={miniHref} />)}
    </div>
    <AdSlot slot="contenido" />
    {page.ciudad && page.tool === 'zbe' && <CityFacts slug={page.ciudad} lang={lang} />}
    <CiudadesAgrupadas hub={page.id} lang={lang} />
    {page.municipio && <MuniFacts slug={page.municipio} lang={lang} />}
    {page.ciudad && page.tool === 'zbe' && !page.municipio && municipio(page.ciudad) && !pageDeMunicipio(page.ciudad) && <MuniFacts slug={page.ciudad} lang={lang} />}
  </article>
</PageLayout>
