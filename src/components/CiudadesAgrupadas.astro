---
/**
 * Pages sans URL propre (RECETTE §3, 100 pages au plus), rendues dans leur page récapitulative à l'ancre `#<id>` :
 * - villes ZBE : bloc citable, texte, FAQ et fiche générée depuis src/data/zbe/<ville>.json, en accordéon ;
 * - communes IVTM : bloc citable, texte, FAQ et cuadro de la ordenanza (tarifs, bonifications, source), en accordéon ;
 * - guides : section à ancre, message et mini-simulateur visibles, texte et FAQ repliés.
 * Le texte reste entier dans le HTML ; une ancre ouvre l'accordéon visé.
 */
import CityFacts from './CityFacts.astro';
import MuniFacts from './MuniFacts.astro';
import MiniSim from './calc/MiniSim';
import { municipio } from '../lib/engine/ivtm';
import { agrupadasEn, ivtmCubierto } from '../lib/pages';
import { helpers } from '../lib/helpers';
import { route, type Locale } from '../i18n/routes';
import type { PageDef } from '../lib/page-types';
interface Props { hub: string; lang: Locale }
const { hub, lang } = Astro.props;
const es = lang === 'es';
const h = helpers(lang);
const items = agrupadasEn(hub);
const ciudades = items.filter((p) => p.ciudad && p.tool === 'zbe');
const municipios = items.filter((p) => p.municipio);
const guias = items.filter((p) => !ciudades.includes(p) && !municipios.includes(p));
const cuerpo = (p: PageDef) => p[lang].body(h).replace(/<!--mini:[A-Za-z0-9_]+-->/g, '').replace(/<h2>/g, '<h3>').replace(/<\/h2>/g, '</h3>');
const miniHref = route('home', lang);
---
{ciudades.length > 0 && (
  <section class="mt-10 border-t border-navy-200 pt-6" aria-labelledby="otras-ciudades">
    <h2 id="otras-ciudades" class="text-2xl font-bold text-navy-900">{es ? `Las otras ${ciudades.length} ciudades, una a una` : `The other ${ciudades.length} cities, one by one`}</h2>
    <p class="mt-2 text-navy-700">{es ? 'Cada ficha recoge la ordenanza, las excepciones, la multa, el calendario y las fuentes oficiales de la ciudad. Elige la ciudad en el simulador de arriba para ver la regla que se aplica a tu coche.' : 'Each entry sets out the city’s byelaw, exceptions, fine, timetable and official sources. Pick the city in the tool above to see the rule that applies to your car.'}</p>
    <div class="mt-4 space-y-3">
      {ciudades.map((p) => { const x = p[lang]; const faqs = x.faqs(h); return (
        <details id={p.id} class="ciudad-acc scroll-mt-24 rounded-lg border border-navy-200 bg-white">
          <summary class="cursor-pointer px-4 py-3"><span class="font-semibold text-navy-900">{x.h1}</span><span class="block text-sm text-navy-600">{x.card}</span></summary>
          <div class="border-t border-navy-100 px-4 pb-5 pt-3">
            <p class="text-navy-800">{x.intro}</p>
            <p class="mt-3 text-navy-800">{x.resume(h)}</p>
            <div class="prose prose-slate mt-4 max-w-none"><Fragment set:html={cuerpo(p)} /></div>
            {faqs.length > 0 && (
              <div class="mt-4">
                <h3 class="text-lg font-semibold text-navy-900">{es ? 'Preguntas frecuentes' : 'Frequently asked questions'}</h3>
                {faqs.map((f) => <><p class="mt-3 font-semibold text-navy-900">{f.q}</p><p class="mt-1 text-navy-800">{f.a}</p></>)}
              </div>
            )}
            {p.ciudad && <CityFacts slug={p.ciudad} lang={lang} />}
            {p.ciudad && municipio(p.ciudad) && !ivtmCubierto(p.ciudad) && <MuniFacts slug={p.ciudad} lang={lang} />}
          </div>
        </details>
      ); })}
    </div>
  </section>
)}
{municipios.length > 0 && (
  <section class="mt-10 border-t border-navy-200 pt-6" aria-labelledby="otros-municipios">
    <h2 id="otros-municipios" class="text-2xl font-bold text-navy-900">{es ? `${municipios.length} municipios más, uno a uno` : `${municipios.length} more towns, one by one`}</h2>
    <p class="mt-2 text-navy-700">{es ? 'Cada ficha recoge el cuadro de turismos 2026 de la ordenanza fiscal, las bonificaciones, lo que cambia este año y la fuente oficial con su fecha. Elige el municipio en el simulador de arriba para calcular la cuota de tu coche.' : 'Each entry gives the 2026 car rates from the tax byelaw, the relief, what changes this year and the official source with its date. Pick the town in the calculator above to work out your car’s amount.'}</p>
    <div class="mt-4 space-y-3">
      {municipios.map((p) => { const x = p[lang]; const faqs = x.faqs(h); return (
        <details id={p.id} class="ciudad-acc scroll-mt-24 rounded-lg border border-navy-200 bg-white">
          <summary class="cursor-pointer px-4 py-3"><span class="font-semibold text-navy-900">{x.h1}</span><span class="block text-sm text-navy-600">{x.intro}</span></summary>
          <div class="border-t border-navy-100 px-4 pb-5 pt-3">
            <p class="text-navy-800">{x.resume(h)}</p>
            <div class="prose prose-slate mt-4 max-w-none"><Fragment set:html={cuerpo(p)} /></div>
            {faqs.length > 0 && (
              <div class="mt-4">
                <h3 class="text-lg font-semibold text-navy-900">{es ? 'Preguntas frecuentes' : 'Frequently asked questions'}</h3>
                {faqs.map((f) => <><p class="mt-3 font-semibold text-navy-900">{f.q}</p><p class="mt-1 text-navy-800">{f.a}</p></>)}
              </div>
            )}
            <MuniFacts slug={p.municipio!} lang={lang} />
          </div>
        </details>
      ); })}
    </div>
  </section>
)}
{guias.map((p) => { const x = p[lang]; const faqs = x.faqs(h); return (
  <section id={p.id} class="scroll-mt-24 mt-10 border-t border-navy-200 pt-6" aria-labelledby={`t-${p.id}`}>
    <h2 id={`t-${p.id}`} class="text-2xl font-bold text-navy-900">{x.h1}</h2>
    <p class="mt-2 text-navy-700">{x.intro}</p>
    {p.mini && <MiniSim client:visible kind={p.mini} lang={lang} href={miniHref} defaults={p.miniDefaults} />}
    <p class="mt-3 text-navy-800">{x.resume(h)}</p>
    <details class="ciudad-acc mt-4 rounded-lg border border-navy-200 bg-white">
      <summary class="cursor-pointer px-4 py-3 font-semibold text-navy-900">{es ? 'Leer el detalle y las preguntas frecuentes' : 'Read the details and FAQs'}</summary>
      <div class="border-t border-navy-100 px-4 pb-5 pt-3">
        <div class="prose prose-slate max-w-none"><Fragment set:html={cuerpo(p)} /></div>
        {faqs.length > 0 && (
          <div class="mt-4">
            <h3 class="text-lg font-semibold text-navy-900">{es ? 'Preguntas frecuentes' : 'Frequently asked questions'}</h3>
            {faqs.map((f) => <><p class="mt-3 font-semibold text-navy-900">{f.q}</p><p class="mt-1 text-navy-800">{f.a}</p></>)}
          </div>
        )}
      </div>
    </details>
  </section>
); })}
{items.length > 0 && <script is:inline>(function(){function o(){var id=decodeURIComponent(location.hash.slice(1));if(!id)return;var d=document.getElementById(id);if(!d)return;if(d.tagName!=='DETAILS')d=d.querySelector('details')||d;if(d.tagName==='DETAILS'){d.open=true;}document.getElementById(id).scrollIntoView();}window.addEventListener('hashchange',o);o();})();</script>}
