---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/zbe/?lang=en" title="Can I drive into the ZBE? DGT label and Spanish road tax" width="100%" height="1100" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the free Spanish ZBE and DGT label checker on your site" description="Embed the free “can I drive into the ZBE?” checker with the DGT label and Spanish road tax on your website: copy the iframe, no account, no cookies, always up to date." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the tool on your site</h1>
    <p class="mt-3 text-lg text-navy-700">For car hire firms, holiday lets, expat forums, driving schools and local media: copy it once and the byelaws stay up to date by themselves.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Terms: the credit link under the tool stays visible, the tool is not altered and it comes with no warranty. Remove <code>?lang=en</code> for the Spanish version.</p>
    <p>What your readers type stays on their device; the frame stores and measures nothing. Questions via the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/zbe/?lang=en" title="Can I drive into the ZBE?" width="100%" height="1100" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
